<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- Mirino Fotocamera a Schermo Intero per Schermo Tablet -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Barra Superiore Tablet -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MiaFotocamera Studio"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Switch Sfondo Bianco + Ombra Morbida ad ogni scatto -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/studioModeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Sfondo Bianco + Ombra"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:useMaterialThemeColors="true" />
    </LinearLayout>

    <!-- Barra Inferiore Controlli Tablet -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#66000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Pulsante Inverti Fotocamera -->
        <ImageButton
            android:id="@+id/switchCameraButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Inverti Fotocamera"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#FFFFFF" />

        <!-- Pulsante Otturatore Grande per Tablet -->
        <Button
            android:id="@+id/imageCaptureButton"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@android:drawable/btn_default"
            android:elevation="6dp"
            android:text="📸"
            android:textSize="28sp" />

        <Space
            android:layout_width="104dp"
            android:layout_height="wrap_content" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
